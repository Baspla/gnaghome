GNAGHOME_BETTER_AUTH_SECRET=seeeeeecret
GNAGHOME_BETTER_AUTH_URL=http://localhost:5173
GNAGHOME_HOSTNAME=http://localhost:5173
GNAGHOME_DATABASE_URL=data/sqlite.db
# File bytes are stored on local disk under the backend's persistent data volume.
GNAGHOME_FILES_DIRECTORY=data/files
# Generate a VAPID key pair with `bunx web-push generate-vapid-keys`.
# Keep the private key secret and stable across restarts; subject may be mailto: or HTTPS.
GNAGHOME_VAPID_PUBLIC_KEY=
GNAGHOME_VAPID_PRIVATE_KEY=
GNAGHOME_VAPID_SUBJECT=mailto:admin@example.com
GNAGHOME_OAUTH_DISCOVERY_URL=https://oidc.example.com/.well-known/openid-configuration
GNAGHOME_OAUTH_CLIENT_ID=example-client-id
GNAGHOME_OAUTH_CLIENT_SECRET=example-client-secret
GNAGHOME_OAUTH_PROVIDER_ID=oauthproviderid
# Exact OIDC group name whose members are dashboard admins; unset means no admins
GNAGHOME_ADMIN_GROUP=dashboard-admins
GNAGHOME_LOG_LEVEL=info
