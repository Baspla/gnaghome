# Frontend environment variables
# Public variables (available to client code) must be prefixed with PUBLIC_

PUBLIC_GNAGHOME_OAUTH_PROVIDER_ID=oauthproviderid
PUBLIC_GNAGHOME_API_URL=http://localhost:3000
GNAGHOME_API_URL_INTERNAL=http://localhost:3000/api
PUBLIC_GNAGHOME_BETTER_AUTH_URL=http://localhost:3000

# Log level: 'error' | 'warn' | 'info' | 'debug'
# Defaults to 'info' in dev, 'warn' in production
# PUBLIC_GNAGHOME_LOG_LEVEL=info
